# Vorlage für die Zugangsdaten des Dienstprinzipals.
#
# Auf dem Server ablegen als /home/ubuntu/.azure-backup.env
# und anschließend die Rechte setzen:
#
#   chmod 600 /home/ubuntu/.azure-backup.env
#
# 600 heißt: nur der Besitzer darf lesen und schreiben.
# Diese Datei gehört NIEMALS in ein Repository.

# Anwendungs-ID (Client) der App-Registrierung
AZ_APP_ID=<ANWENDUNGS-ID>

# Verzeichnis-ID (Mandant) des Entra-Tenants
AZ_TENANT=<VERZEICHNIS-ID>

# Geheimer Clientschlüssel, Spalte "Wert" aus Zertifikate & Geheimnisse.
# Wird in Azure nur ein einziges Mal angezeigt.
AZ_SECRET=<CLIENT-SECRET>

# Name des Speicherkontos
AZ_ACCOUNT=<STORAGE-ACCOUNT>

# Name des Containers
AZ_CONTAINER=minecraft-backups
